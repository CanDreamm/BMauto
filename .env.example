VK_TOKEN=
VK_GROUP_ID=
# Bot administrators (numeric VK IDs, comma-separated). Invite project members in VK.
VK_ALLOWED_USERS=
GOOGLE_CREDENTIALS_FILE=token.json
# One-time application setup. Each project's account is then connected in VK.
GOOGLE_OAUTH_CLIENT_FILE=credentials-web.json
GOOGLE_OAUTH_REDIRECT_URI=https://bot.itiscat.ru/oauth/google/callback
GOOGLE_OAUTH_PORT=8787
# Optional: import legacy projects once; leave empty for all setup through VK.
APP_CONFIG=
APP_DATA=data
# Optional until generation is used. Never put keys in config.json.
GENAPI_API_KEY=
# Candidate budget model; confirm slug and current prices in GenAPI first.
GENAPI_MODEL=gpt-4o-mini
